# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iran_cat?schema=public"

# CORS (comma-separated origins; use * only in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# MinIO (object storage for cat images)
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=iran-cat
MINIO_PUBLIC_URL=http://localhost:19000/iran-cat

# Daily limit for cat read API (per user)
DAILY_CAT_READ_LIMIT=3
