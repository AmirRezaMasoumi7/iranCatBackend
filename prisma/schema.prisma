generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

model User {
  id                        String   @id @default(cuid())
  fullName                  String   @map("full_name")
  username                  String   @unique
  phoneNumber               String   @map("phone_number")
  city                      String
  subscriptionExpiryDate    DateTime @map("subscription_expiry_date")
  role                      UserRole @default(user)
  password                  String   @default("")
  passwordHash              String   @map("password_hash")
  jwtToken                  String?  @map("jwt_token") @db.Text
  device                    String?
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([phoneNumber])
  @@index([role])
  @@map("users")
}

model UserLoginLog {
  id        String   @id @default(cuid())
  username  String
  loggedInAt DateTime @default(now()) @map("logged_in_at")
  device    String

  @@index([username])
  @@index([username, loggedInAt])
  @@map("user_login_logs")
}

model Cat {
  oemCode      String     @id @map("oem_code") @db.VarChar(50)
  carBrand     String?    @map("car_brand") @db.VarChar(100)
  description  String?    @db.Text
  weightGram   Decimal?   @map("weight_gram") @db.Decimal(10, 2)
  palladiumPpm Decimal?   @map("palladium_ppm") @db.Decimal(10, 2)
  platinumPpm  Decimal?   @map("platinum_ppm") @db.Decimal(10, 2)
  rhodiumPpm   Decimal?   @map("rhodium_ppm") @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  images       CatImage[]

  @@map("cats")
}

model CatImage {
  id        String @id @default(uuid()) @db.Uuid
  oemCode   String @map("oem_code") @db.VarChar(50)
  imageUrl  String @map("image_url") @db.Text
  sortOrder Int    @default(0) @map("sort_order")
  cat       Cat    @relation(fields: [oemCode], references: [oemCode], onDelete: Cascade)

  @@index([oemCode])
  @@map("cat_images")
}

model LogUserCat {
  id          String   @id @default(cuid())
  username    String
  oemCode     String   @map("oem_code") @db.VarChar(50)
  requestedAt DateTime @default(now()) @map("requested_at")

  @@index([username])
  @@index([username, requestedAt])
  @@map("log_user_cat")
}

model Price {
  name  String  @id @db.VarChar(100)
  price Decimal @db.Decimal(10, 2)

  @@map("price")
}
